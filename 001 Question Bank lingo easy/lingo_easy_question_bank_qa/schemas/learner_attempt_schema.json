{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingo-easy/learner_attempt_schema",
  "title": "Learner attempt record (one row per question per attempt)",
  "description": "Dynamic learner data. Stored OUTSIDE the question bank (exams/<exam_id>.attempt.json today; a database table in production). Static question metadata is joined by question_uuid, never copied back into the bank.",
  "type": "object",
  "required": ["schema_version", "attempt_record_id", "assessment_id", "attempt_id", "learner_id", "exam_type", "question_id", "question_uuid", "question_version", "part_id", "modality", "question_cefr", "answered", "selected_option", "is_correct", "primary_subskill", "learning_objectives"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "attempt_record_id": {"type": "string", "description": "attempt_id + ':' + question_id; unique key"},
    "assessment_id": {"type": "string", "description": "exam_id of the assembled exam"},
    "attempt_id": {"type": "string"},
    "learner_id": {"type": "string", "description": "pseudonymous identifier; never an email or name"},
    "exam_type": {"type": "string"},
    "level_target": {"type": ["string", "null"]},
    "blueprint_version": {"type": ["string", "null"]},
    "seed": {"type": ["integer", "null"]},
    "started_at": {"type": ["string", "null"]},
    "submitted_at": {"type": ["string", "null"]},
    "question_id": {"type": "string"},
    "question_uuid": {"type": "string"},
    "question_version": {"type": ["string", "null"], "description": "content_hash of the part at assembly time (items have no own version yet)"},
    "part_id": {"type": "string"},
    "part_uuid": {"type": ["string", "null"]},
    "source_id": {"type": "string"},
    "modality": {"enum": ["reading", "listening"]},
    "question_cefr": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]},
    "answered": {"type": "boolean"},
    "selected_option": {"type": ["string", "null"], "description": "letter shown to the learner (options are shuffled per exam)"},
    "selected_option_bank_id": {"type": ["string", "null"], "description": "letter of the same option in the bank (join key for distractor diagnostics)"},
    "selected_option_text": {"type": ["string", "null"]},
    "is_correct": {"type": "boolean"},
    "response_time_ms": {"type": ["integer", "null"], "minimum": 0},
    "primary_subskill": {"type": ["string", "null"]},
    "secondary_subskills": {"type": "array", "items": {"type": "string"}},
    "learning_objectives": {"type": "array", "items": {"type": "string", "pattern": "^LO\\."}},
    "distractor_diagnostic": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["error_tags", "diagnostic_confidence", "evidence_class", "provenance"],
                              "properties": {"error_tags": {"type": "array", "items": {"type": "string"}}, "diagnostic_confidence": {"enum": ["high", "medium", "low"]},
                                             "evidence_class": {"enum": ["text_grounded", "item_structure"]}, "provenance": {"type": "string"}}}]}
  }
}
