{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingo-easy/question_schema_v2",
  "title": "Lingo Easy question record v2 (export / sidecar view)",
  "description": "Flat, self-describing view of ONE multiple-choice question. The authoritative bank stays in part.json (schema v1, unchanged and still valid); v2 records are generated from it by qa/stage6_diagnostics.py and never hold learner data. See docs/schema_decisions.md.",
  "type": "object",
  "required": ["schema_version", "question_id", "uuid", "part_id", "part_uuid", "source_file", "bank", "assessment_type", "modality", "item_format", "prompt", "options", "answer", "evidence", "explanation", "level", "skills", "topic", "distractor_diagnostics", "review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "question_id": {"type": "string", "pattern": "^(LI|RE)[0-9]{3,4}-Q[0-9]{2}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "part_id": {"type": "string", "pattern": "^(LI|RE)[0-9]{3,4}$"},
    "part_uuid": {"type": "string"},
    "source_file": {"type": "string"},
    "bank": {"type": "string", "pattern": "^(placement|assessment_(A1|A2|B1|B2|C1|C2))$"},
    "assessment_type": {"type": "string"},
    "modality": {"enum": ["reading", "listening"]},
    "item_format": {"enum": ["multiple_choice", "true_false_not_given", "yes_no_not_given", "sentence_completion", "matching_information"]},
    "prompt": {"type": "string", "minLength": 3},
    "options": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["id", "text"], "additionalProperties": false, "properties": {"id": {"enum": ["A", "B", "C", "D"]}, "text": {"type": "string", "minLength": 1}}}},
    "answer": {"enum": ["A", "B", "C", "D"]},
    "evidence": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["quote"], "properties": {"quote": {"type": "string", "minLength": 3}, "paragraph": {"type": "string"}}}]},
    "explanation": {"type": "string", "minLength": 15},
    "level": {"type": "object", "required": ["original_cefr", "original_band", "text_cefr"], "additionalProperties": false,
              "properties": {"original_cefr": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]}, "original_band": {"type": "number", "minimum": 1, "maximum": 9}, "text_cefr": {"enum": ["A1", "A2", "B1", "B2", "C1", "C2"]}}},
    "skills": {"type": "object", "required": ["original_skill_tag", "primary_subskill", "cognitive_process"],
               "properties": {"original_skill_tag": {"type": "string"}, "primary_subskill": {"type": "string"}, "recommended_primary_subskill": {"type": "string"},
                              "secondary_subskills": {"type": "array", "items": {"type": "string"}}, "cognitive_process": {"enum": ["retrieve", "interpret", "infer", "integrate", "evaluate"]},
                              "answer_type": {"type": "string"}, "validation": {"enum": ["consistent", "inconsistent", "not_verifiable"]}}},
    "topic": {"type": "string"},
    "language_focus": {"type": "object"},
    "distractor_diagnostics": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["option_id", "is_correct", "rationale", "error_tags", "targeted_subskills", "diagnostic_confidence", "evidence_basis"],
                               "properties": {"option_id": {"enum": ["A", "B", "C", "D"]}, "is_correct": {"type": "boolean"}, "rationale": {"type": "string"}, "error_tags": {"type": "array", "items": {"type": "string"}},
                                              "targeted_subskills": {"type": "array", "items": {"type": "string"}}, "diagnostic_confidence": {"enum": ["high", "medium", "low", "n/a"]},
                                              "evidence_basis": {"type": "string"}, "evidence_class": {"enum": ["text_grounded", "item_structure", "explanation_field"]}}}},
    "review": {"type": "object", "required": ["review_version"], "properties": {"review_version": {"type": "string"}, "diagnostics_class": {"type": "string"}}}
  }
}
