  "diagnostics": {
    "policy": {
      "observed_error_vs_weakness": "A diagnostic category is an OBSERVED error pattern when at least one instance is found in a response. It may be reported as an INFERRED learning weakness only after >= 3 instances in one response set of >= 100 words (or >= 2 responses) and when the error is not explained by task demands (for example a tense the task did not invite).",
      "min_instances_for_pattern": 3,
      "min_responses_for_weakness": 2
    },
    "categories": {
      "D_VOCAB_RANGE": {
        "label": "Limited vocabulary range",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Same few words reused where varied or more specific words were available",
        "criteria": [
          "W_LR",
          "S_LR"
        ]
      },
      "D_VOCAB_REPEAT": {
        "label": "Repetitive expressions",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Same word or phrase repeated three or more times in a short response",
        "criteria": [
          "W_LR",
          "S_LR",
          "S_FC"
        ]
      },
      "D_WORD_CHOICE": {
        "label": "Inaccurate word choice or collocation",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Word exists but does not fit meaning or collocation",
        "criteria": [
          "W_LR",
          "S_LR"
        ]
      },
      "D_SPELLING": {
        "label": "Spelling and mechanics",
        "skills": [
          "writing"
        ],
        "indicator": "Misspelt common words, capitalisation or punctuation errors that affect clarity",
        "criteria": [
          "W_LR",
          "W_GRA"
        ]
      },
      "D_TENSE": {
        "label": "Incorrect tense or aspect",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Verb form does not match time reference",
        "criteria": [
          "W_GRA",
          "S_GRA"
        ]
      },
      "D_SVA": {
        "label": "Subject-verb agreement",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Verb does not agree with subject in number or person",
        "criteria": [
          "W_GRA",
          "S_GRA"
        ]
      },
      "D_ARTICLE": {
        "label": "Article and determiner errors",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Missing, extra or wrong a/an/the or determiner",
        "criteria": [
          "W_GRA",
          "S_GRA"
        ]
      },
      "D_PREPOSITION": {
        "label": "Preposition errors",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Wrong or missing preposition",
        "criteria": [
          "W_GRA",
          "S_GRA"
        ]
      },
      "D_SENTENCE_CONSTRUCTION": {
        "label": "Weak sentence construction",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Fragments, run-ons, word-order errors, missing verb or subject",
        "criteria": [
          "W_GRA",
          "S_GRA"
        ]
      },
      "D_GRAMMAR_RANGE": {
        "label": "Limited grammatical range",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Only simple structures where the task invited complex ones",
        "criteria": [
          "W_GRA",
          "S_GRA"
        ]
      },
      "D_COHESION": {
        "label": "Limited or inaccurate cohesive devices",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Few or mechanical linkers; unclear reference",
        "criteria": [
          "W_CC",
          "S_FC"
        ]
      },
      "D_ORGANISATION": {
        "label": "Weak organisation or paragraphing",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "No clear opening, development, closing; ideas in random order",
        "criteria": [
          "W_ORG",
          "W_CC",
          "S_FC"
        ]
      },
      "D_ARGUMENT": {
        "label": "Inadequate argument development",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "Claims without reasons, or reasons without explanation",
        "criteria": [
          "W_ORG",
          "W_TA",
          "S_DEV"
        ]
      },
      "D_SUPPORT": {
        "label": "Weak supporting examples or details",
        "skills": [
          "writing",
          "speaking"
        ],
        "indicator": "No concrete example or detail after a general statement",
