{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingoeasy/productive_attempt.schema.json",
  "title": "Learner attempt for a Writing or Speaking Part (stored outside the question bank)",
  "type": "object",
  "required": [
    "attempt_id",
    "learner_id",
    "part_id",
    "part_uuid",
    "part_version",
    "part_content_hash",
    "skill",
    "response_modality",
    "response_text",
    "submitted_at"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "part_id": {
      "type": "string",
      "minLength": 1
    },
    "part_uuid": {
      "type": "string",
      "minLength": 1
    },
    "part_version": {
      "type": "string",
      "minLength": 1
    },
    "part_content_hash": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "enum": [
        "writing",
        "speaking"
      ]
    },
    "response_modality": {
      "enum": [
        "typed_text",
        "audio"
      ]
    },
    "response_text": {
      "type": "string"
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "time_spent_seconds": {
      "type": "number",
      "minimum": 0
    },
    "submitted_at": {
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "type": "object",
      "description": "Optional. Present only for real audio attempts.",
      "properties": {
        "audio_asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "audio_duration_seconds": {
          "type": "number"
        },
        "transcript": {
          "type": "string",
          "minLength": 1
        },
        "stt_provider": {
          "type": "string",
          "minLength": 1
        },
        "stt_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "evaluation": {
      "type": "object",
      "description": "Written later by the evaluation pipeline (not implemented in this task); follows evaluation_blueprint.evaluator_output_contract."
    }
  }
}
